# Copy to .env next to docker-compose.yml and fill in — do NOT commit .env.
#
# Generate at https://login.tailscale.com/admin/settings/keys:
#   - Reusable: yes (so a container recreate doesn't need a fresh key)
#   - Ephemeral: no (fafnir should stay a stable, persistent tailnet node)
#   - Expiration: your call, but remember to rotate before it lapses
#   - Tags: NONE — leave "Advertise tags" unchecked. A tag the ACL doesn't
#     know about caused an endless reconnect loop on the SABnzbd setup.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxxx
